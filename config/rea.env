# =============================================================================
#  Optional REA runtime settings for this stack.
#
#  Loaded in two ways:
#    * compose `env_file` -> the container environment (so `docker exec -i
#      rea-agent rea mcp` sees them too), and
#    * the entrypoint sources /etc/rea/rea.env for its own overrides.
#
#  Only variables you actually write are defined. Do NOT leave a variable
#  present-but-empty (e.g. "REA_ANALYSIS_PROVIDER="): REA validates these and
#  rejects empty strings with `configuration_invalid`, which makes every
#  command fail. Comment a setting out instead of blanking it.
#
#  Template: docker/rea.env.example (a copy of this file with commentary).
# =============================================================================

# Standing analysis-engine preference: ghidra | hopper | ida
# REA_ANALYSIS_PROVIDER=ghidra

# Provider startup deadlines (milliseconds) for very large targets
# REA_GHIDRA_STARTUP_TIMEOUT_MS=1800000
# REA_HOPPER_STARTUP_TIMEOUT_MS=600000

# Ghidra JVM heap (GHIDRA_HEADLESS_MAXMEM takes precedence over GHIDRA_MAXMEM)
# GHIDRA_HEADLESS_MAXMEM=8G

# Ghidra import overrides for raw/headerless or unusual images
# REA_GHIDRA_LANGUAGE_ID=x86:LE:32:default
# REA_GHIDRA_COMPILER_SPEC_ID=borlandcpp
# REA_GHIDRA_SEED_FILE=/work/seeds.tsv
# REA_GHIDRA_DISABLED_ANALYZERS=WindowsResourceReference
# REA_GHIDRA_NATIVEAOT_JAR=/opt/rea-ghidra-nativeaot.jar

# MCP surface shaping (the image default is compact)
# REA_MCP_INPUT_SCHEMA_PROFILE=full
# REA_MCP_MAX_RESPONSE_BYTES=2000000

# IDA (bring your own install + licence) - see docs/BYO-LICENSES.md
# REA_IDA_MCP_CONFIG=/home/rea/.rea/ida-mcp.json
# REA_IDA_MCP_FORWARD=ida-mcp:8745
# REA_IDA_MCP_LOCAL_PORT=8745

# JEB (bring your own licence)
# REA_JEB_MCP_URL=http://127.0.0.1:8425/mcp
# REA_JEB_MCP_FORWARD=jeb-host:8425

# Misc
# REA_LOG_LEVEL=debug
# REA_BROWSER_EXECUTABLE=/opt/ms-playwright/chromium-1208/chrome-linux/chrome

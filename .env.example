# =============================================================================
#  rea-agent configuration - copy to .env and edit.
#    cp .env.example .env
# =============================================================================

# --- image / build -----------------------------------------------------------
REA_IMAGE=rea-agent:6.4.0-linux-amd64
REA_VERSION=6.4.0
NODE_VERSION=24.21.0
GHIDRA_VERSION=12.1.4
GHIDRA_ZIP=ghidra_12.1.4_PUBLIC_20260921.zip
# Optional: pin the Ghidra archive digest (see docs/TROUBLESHOOTING.md)
GHIDRA_SHA256=
HOPPER_DEB_URL=https://www.hopperapp.com/downloader/public/Hopper-6.5.0-Linux-demo.deb

# Optional components (1 = install, 0 = skip)
INSTALL_CHROME=1
INSTALL_PLAYWRIGHT=1
INSTALL_PWNDBG=1
INSTALL_WINE=1
INSTALL_CROSS_TOOLCHAINS=1
# auto = install vendor/ida/*.run when present, never download IDA
INSTALL_IDA=auto

# --- runtime identity --------------------------------------------------------
# Match your host user so ./work stays writable without sudo:  id -u / id -g
REA_UID=1000
REA_GID=1000
REA_CONTAINER_NAME=rea-agent
REA_HOME_VOLUME=rea-agent-home
REA_SHM_SIZE=1gb

# --- mounts ------------------------------------------------------------------
REA_TARGETS_DIR=./targets
IDA_INSTALL_DIR=./vendor/ida
IDA_LICENSE_DIR=./config/ida
IDA_MCP_CONFIG_FILE=./config/ida-mcp.json
HOPPER_STATE_VOLUME=./vendor/hopper-state

# --- analysis engines --------------------------------------------------------
# ghidra | hopper | ida  (empty = let REA pick per target)
REA_ANALYSIS_PROVIDER=
GHIDRA_INSTALL_DIR=/opt/ghidra
JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64
HOPPER_LAUNCHER_PATH=/opt/hopper/bin/Hopper
HOPPER_STATE_DIR=/home/rea/.local/share/hopper
REA_GHIDRA_STARTUP_TIMEOUT_MS=900000
REA_HOPPER_STARTUP_TIMEOUT_MS=300000
GHIDRA_HEADLESS_MAXMEM=4G
REA_GHIDRA_DISABLED_ANALYZERS=
REA_GHIDRA_LANGUAGE_ID=
REA_GHIDRA_COMPILER_SPEC_ID=
REA_GHIDRA_SEED_FILE=
REA_GHIDRA_NATIVEAOT_JAR=

# --- IDA / JEB (bring your own licence) --------------------------------------
IDADIR=/opt/ida
REA_IDA_MCP_CONFIG=
REA_IDA_MCP_FORWARD=
REA_IDA_MCP_LOCAL_PORT=8745
REA_JEB_MCP_URL=
REA_JEB_MCP_FORWARD=
IDA_MCP_IMAGE=
IDA_MCP_MAX_WORKERS=1

# --- MCP surface -------------------------------------------------------------
# compact trims REA's 170+ tool schemas (~290 KB vs ~496 KB per request)
REA_MCP_INPUT_SCHEMA_PROFILE=compact
REA_MCP_MAX_RESPONSE_BYTES=
REA_MCP_HTTP_BIND=127.0.0.1
REA_MCP_HTTP_PORT=8811
REA_LOG_LEVEL=info
REA_ENTRYPOINT_DOCTOR=1

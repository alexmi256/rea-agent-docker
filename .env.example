# =============================================================================
#  rea-agent configuration - copy to .env and edit.
#    cp .env.example .env
# =============================================================================

# --- image / build -----------------------------------------------------------
# Four engine images. All share the auxiliary toolchain; only the native
# analysis engine differs (see docs/IMAGES.md).
#
# These default to the published GHCR images, so `docker compose pull` (or
# `make pull`) fetches a ready-built image and you never build anything. The same
# names are used by scripts/build.sh and the Makefile, so a local build
# overwrites the pulled image instead of creating a second, differently-named one.
# Building from source: `make build-ghidra` (etc.) works with these values as-is.
REA_IMAGE=ghcr.io/alexmi256/rea-agent:6.4.0-linux-amd64
REA_GHIDRA_IMAGE=ghcr.io/alexmi256/rea-agent-ghidra:6.4.0-linux-amd64
REA_HOPPER_IMAGE=ghcr.io/alexmi256/rea-agent-hopper:6.4.0-linux-amd64
REA_IDA_IMAGE=ghcr.io/alexmi256/rea-agent-ida:6.4.0-linux-amd64
# Which engine the compose sidecar (compose.http.yml) runs. Must match whichever
# of the four images you started.
REA_ENGINE=all
REA_VERSION=6.4.0
NODE_VERSION=24.21.0
GHIDRA_VERSION=12.1.4
GHIDRA_ZIP=ghidra_12.1.4_PUBLIC_20260921.zip
# Optional: pin the Ghidra archive digest (see docs/TROUBLESHOOTING.md)
GHIDRA_SHA256=
# Hopper: leave HOPPER_DEB_URL empty to download the exact Linux demo package
# REA pins (Hopper 6.4.2, matched by launcher digest). A licensed DEB goes in
# vendor/ instead - that path skips these checks entirely.
HOPPER_DEB_URL=
HOPPER_DEB_SHA1=e4f79dff602648a8ff4a88b773875b6bfac0dc65
HOPPER_DEB_BYTES=35755772

# Optional components (1 = install, 0 = skip)
INSTALL_CHROME=1
INSTALL_PLAYWRIGHT=1
INSTALL_PWNDBG=1
INSTALL_WINE=1
INSTALL_CROSS_TOOLCHAINS=1
# auto = install vendor/ida/*.run when present, never download IDA
INSTALL_IDA=auto

# --- runtime identity --------------------------------------------------------
# Match your host user so ./work stays writable without sudo:  id -u / id -g
# (scripts/build.sh and compose both pass these through; the image copes with
# the default 1000 even though Ubuntu ships a stock uid 1000 user)
REA_UID=1000
REA_GID=1000
REA_CONTAINER_NAME=rea-agent
REA_GHIDRA_CONTAINER_NAME=rea-agent-ghidra
REA_HOPPER_CONTAINER_NAME=rea-agent-hopper
REA_IDA_CONTAINER_NAME=rea-agent-ida
REA_MCP_HTTP_CONTAINER_NAME=rea-mcp-http
REA_HOME_VOLUME=rea-agent-home
REA_SHM_SIZE=1gb

# --- mounts ------------------------------------------------------------------
REA_TARGETS_DIR=./targets
IDA_INSTALL_DIR=./vendor/ida
IDA_LICENSE_DIR=./config/ida
IDA_MCP_CONFIG_FILE=./config/ida-mcp.json
HOPPER_STATE_VOLUME=./vendor/hopper-state

# Docker-outside-of-Docker only: when scripts/build.sh or scripts/verify.sh run
# inside a container that talks to the host Docker daemon (e.g. Hermes in
# Docker with the host socket bind-mounted), volume/context sources are resolved
# by the HOST daemon, so container paths must be translated. Format is
# <container-path>=<host-path>; leave empty on a normal host.
# Example for the Hermes-in-Docker layout:
# HOST_PATH_MAP=/opt/data=/flashcache/hermes
HOST_PATH_MAP=

# --- analysis engines --------------------------------------------------------
# Optional engine settings live in config/rea.env (compose loads it via
# env_file), NOT here: REA rejects empty values such as REA_ANALYSIS_PROVIDER=,
# so an unset knob must stay undefined. Copy docker/rea.env.example to
# config/rea.env and edit that instead.
GHIDRA_INSTALL_DIR=/opt/ghidra
JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64
HOPPER_LAUNCHER_PATH=/opt/hopper/bin/Hopper
HOPPER_STATE_DIR=/home/rea/.local/share/hopper
REA_GHIDRA_STARTUP_TIMEOUT_MS=900000
REA_HOPPER_STARTUP_TIMEOUT_MS=300000
GHIDRA_HEADLESS_MAXMEM=4G

# --- IDA / JEB (bring your own licence) --------------------------------------
IDADIR=/opt/ida
IDA_MCP_IMAGE=
IDA_MCP_MAX_WORKERS=1

# --- MCP surface -------------------------------------------------------------
# compact trims REA's 170+ tool schemas (~290 KB vs ~496 KB per request)
REA_MCP_INPUT_SCHEMA_PROFILE=compact
REA_MCP_HTTP_BIND=127.0.0.1
REA_MCP_HTTP_PORT=8811
REA_LOG_LEVEL=info
REA_ENTRYPOINT_DOCTOR=1

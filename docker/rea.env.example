# Extra REA runtime overrides, loaded by the entrypoint (and only by the
# entrypoint - anything that must also apply to `docker exec -i <ctr> rea mcp`
# belongs in the image ENV or in compose `environment:`).
#
# Copy to ./config/rea.env (mounted read-only at /etc/rea/rea.env).

# Standing analysis-engine preference: ghidra | hopper | ida
# REA_ANALYSIS_PROVIDER=ghidra

# Large binaries need longer provider startup deadlines (milliseconds).
# REA_GHIDRA_STARTUP_TIMEOUT_MS=1800000
# REA_HOPPER_STARTUP_TIMEOUT_MS=600000

# Ghidra JVM heap (chosen from GHIDRA_HEADLESS_MAXMEM, then GHIDRA_MAXMEM, else 2G)
# GHIDRA_HEADLESS_MAXMEM=8G

# Force a Ghidra language/compiler (e.g. Borland C++ PE images)
# REA_GHIDRA_LANGUAGE_ID=x86:LE:32:default
# REA_GHIDRA_COMPILER_SPEC_ID=borlandcpp

# Seed unreachable code (address<TAB>kind[<TAB>name]) and skip stalled analyzers
# REA_GHIDRA_SEED_FILE=/work/seeds.tsv
# REA_GHIDRA_DISABLED_ANALYZERS="Objective-C Message Analyzer"

# Shrink or grow the MCP tool catalog advertised to clients
# REA_MCP_INPUT_SCHEMA_PROFILE=compact      # or: full
# REA_MCP_MAX_RESPONSE_BYTES=2000000

# IDA / JEB (bring your own)
# REA_IDA_MCP_CONFIG=/home/rea/.rea/ida-mcp.json
# REA_IDA_MCP_FORWARD=ida-mcp:8745
# REA_JEB_MCP_URL=http://127.0.0.1:8425/mcp
# REA_JEB_MCP_FORWARD=jeb-host:8425

# Logging
# REA_LOG_LEVEL=debug
